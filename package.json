{
  "name": "cocampus",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export -p web",
    "deploy:hosting": "expo export -p web && firebase deploy --only hosting",
    "build:apk": "dotenv -e .env -- eas build -p android --profile preview",
    "build:ipa": "dotenv -e .env -- eas build -p ios --profile preview",
    "update:ota": "dotenv -e .env -- eas update --auto"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "clsx": "^2.1.1",
    "expo": "^57.0.20",
    "expo-audio": "~57.0.4",
    "expo-document-picker": "~57.0.1",
    "expo-image-picker": "~57.0.16",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "firebase": "^10.12.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dotenv-cli": "^11.0.0",
    "eas-cli": "^23.2.0",
    "firebase-tools": "^15.29.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
